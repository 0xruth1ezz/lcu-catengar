<column padding="6">
  <column padding="16" gap="9" background="surface" border-color="border" radius="lg" grow="1">
    <row gap="9" cross="center">
      <if test="{blueToast}"><icon name="info" width="20" height="20" foreground="info"/></if>
      <if test="{redToast}"><icon name="info" width="20" height="20" foreground="destructive"/></if>
      <if test="{not blueToast and not redToast}"><icon name="{toastIcon}" width="20" height="20" foreground="success"/></if>
      <text grow="1">{toastTitle}</text>
      <text size="sm" foreground="text_muted">Catengar</text>
      <button variant="ghost" size="icon" icon="x" label="关闭提示" on-press="dismiss_toast"/>
    </row>
    <text foreground="text_muted" wrap="true">{toastBody}</text>
  </column>
</column>
